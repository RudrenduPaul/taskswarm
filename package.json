{
  "name": "taskswarm-cli",
  "version": "0.2.0",
  "description": "Self-hosted, event-driven coordination for parallel coding-agent sessions (Claude Code, Codex, Cursor). Push notifications the instant a session blocks, needs review, fails, or finishes, plus a live local status page.",
  "keywords": [
    "coding-agent",
    "multi-agent",
    "claude-code",
    "codex",
    "cursor",
    "agent-orchestration",
    "cli",
    "notifications",
    "push-notifications",
    "self-hosted",
    "event-driven",
    "server-sent-events",
    "hooks"
  ],
  "homepage": "https://github.com/RudrenduPaul/taskswarm",
  "bugs": {
    "url": "https://github.com/RudrenduPaul/taskswarm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RudrenduPaul/taskswarm.git"
  },
  "license": "MIT",
  "author": "Rudrendu Paul",
  "contributors": [
    "Sourav Nandy"
  ],
  "type": "module",
  "bin": {
    "taskswarm": "./dist/cli.js",
    "taskswarm-cli": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "postcss": "^8.5.26"
  }
}
